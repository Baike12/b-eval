# The b-eval platform, served under the {{BASE_PATH}} prefix.
#
# The host's port 80 is a catch-all for iteach, and iteach already routes
# /api/ to its own backend. The platform is therefore mounted under a
# prefix, and its bundle is built with that base path so that its assets
# and its API paths live in a namespace that does not collide.
#
# The trailing slash on proxy_pass strips the prefix, so the container
# receives /api/... and /assets/... exactly as it would at the root.

location = {{BASE_PATH}} {
    return 301 {{BASE_PATH}}/;
}

location {{BASE_PATH}}/ {
    proxy_pass http://127.0.0.1:8091/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # A run is executed inside the request that starts it, and the server
    # cancels it after ten minutes. The proxy must outlast that cap,
    # otherwise nginx cuts the response off before the server does.
    proxy_connect_timeout 10s;
    proxy_send_timeout    700s;
    proxy_read_timeout    700s;
}
